# Database — Prisma connection string
# For local dev: point to localhost
# For Docker: the hostname is "db" (the service name in docker-compose)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"

# PostgreSQL container credentials (used by docker-compose)
POSTGRES_USER=bovitrans
POSTGRES_PASSWORD=bovitrans_pass
POSTGRES_DB=bovitrans
