# ─────────────────────────────────────────────────────────────────────────────
# DEVELOPMENT CREDENTIALS ONLY — do not use in production
# Copy to .env.local for local dev. docker-compose reads this file
# automatically as a fallback when no .env is present.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL container credentials (used by docker-compose)
POSTGRES_USER=bovitrans
POSTGRES_PASSWORD=bovitrans_pass
POSTGRES_DB=bovitrans

# Prisma connection string
# Local dev (DB in Docker, app on localhost): use localhost as host
DATABASE_URL="postgresql://bovitrans:bovitrans_pass@localhost:5432/bovitrans?schema=public"
# Docker full mode: docker-compose overrides DATABASE_URL using the "db" service hostname
