// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  PENDING
  ASSIGNED
  COMPLETED
  CANCELLED
}

model Truck {
  id              String             @id @default(uuid())
  plate           String             @unique
  maxCapacity     Int                @map("max_capacity")
  fuelConsumption Decimal            @db.Decimal(5, 2) @map("fuel_consumption")
  isActive        Boolean            @default(true) @map("is_active")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  requests        TransportRequest[]

  @@map("trucks")
}

model TransportRequest {
  id              String        @id @default(uuid())
  requesterName   String        @map("requester_name")
  requesterPhone  String?       @map("requester_phone")
  cattleCount     Int           @map("cattle_count")
  origin          String
  destination     String
  originLat       Decimal?      @db.Decimal(10, 7) @map("origin_lat")
  originLng       Decimal?      @db.Decimal(10, 7) @map("origin_lng")
  destinationLat  Decimal?      @db.Decimal(10, 7) @map("destination_lat")
  destinationLng  Decimal?      @db.Decimal(10, 7) @map("destination_lng")
  status          RequestStatus @default(PENDING)
  assignedTruckId String?       @map("assigned_truck_id")
  assignedTruck   Truck?        @relation(fields: [assignedTruckId], references: [id], onDelete: SetNull)
  distanceKm      Decimal?      @db.Decimal(10, 2) @map("distance_km")
  fuelCost        Decimal?      @db.Decimal(10, 2) @map("fuel_cost")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([status])
  @@index([assignedTruckId])
  @@map("transport_requests")
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}
